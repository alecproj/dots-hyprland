#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
cd "$ROOT"

if ! command -v python3 >/dev/null 2>&1; then
  echo "python3 not found. Install Arch package 'python'? [y/N]" >&2
  read -r answer
  case "$answer" in
    y|Y|yes|YES)
      sudo pacman -S --needed python
      ;;
    *)
      echo "python3 is required." >&2
      exit 3
      ;;
  esac
fi

exec python3 "$ROOT/additions/tui.py" "$@"
